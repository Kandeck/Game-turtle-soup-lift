# 复制为 .dev.vars 供本地 wrangler 使用： cp .dev.vars.example .dev.vars
# 这些同样是 Cloudflare Pages 控制台里要配置的环境变量。

# 任意 OpenAI 兼容的聊天端点（示例为阿里云 DashScope 国内站）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus

# 汤底加密用的密钥，随便填一个长随机串即可（换了会让旧的 sealed 失效）
SEAL_SECRET=change-me-to-a-long-random-string
