# 复制为 .env 并填入你自己的 key： cp .env.example .env
# 运行： set -a; source .env; set +a; python3 server.py

# 任意 OpenAI 兼容的聊天端点均可（示例为阿里云 DashScope）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus

# 仅在你想重新生成像素素材时才需要（可选）
# 需一个 OpenAI 兼容的文生图端点（/images/generations，返回 b64_json）
IMAGE_API_URL=
IMAGE_API_KEY=
